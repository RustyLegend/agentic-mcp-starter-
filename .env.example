# ─────────────────────────────────────────────────────────────────
#  agentic-mcp-starter — Example Environment Configuration
#
#  1. Copy this file:   cp .env.example .env
#  2. Edit .env with your own values (if needed)
#  3. The defaults below work without any changes for mock mode
# ─────────────────────────────────────────────────────────────────

# LLM provider — use "mock" for the workshop (no API key required)
LLM_PROVIDER=mock

# MCP mode — "local" means the server runs in the same process
MCP_MODE=local

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
